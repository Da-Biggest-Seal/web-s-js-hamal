<%- include("partials/head", { title: "Recenze", css: "recenze" }) %>
<%- include("partials/header", { active: "recenze" }) %>

<main>
    <h1>Recenze</h1>

    <section>
        <h2>Napište recenzi</h2>
        <% if (chyba) { %>
            <p class="chyba"><%= chyba %></p>
        <% } %>
        <form action="/recenze" method="post">
            <label for="nadpis">Nadpis</label>
            <input type="text" id="nadpis" name="nadpis" maxlength="100" required>

            <label for="popis">Popis</label>
            <textarea id="popis" name="popis" rows="5" required></textarea>

            <button type="submit">Odeslat</button>
        </form>
    </section>

    <section>
        <h2>Všechny recenze</h2>
        <% if (recenze.length === 0) { %>
            <p>Zatím tu nejsou žádné recenze.</p>
        <% } else { %>
            <ul class="seznam">
                <% recenze.slice().reverse().forEach(r => { %>
                    <li>
                        <a href="/recenze/<%= r.id %>"><%= r.nadpis %></a>
                        <form action="/recenze/<%= r.id %>/smazat" method="post" onsubmit="return confirm('Opravdu smazat tuto recenzi?')">
                            <button type="submit" class="smazat">Smazat</button>
                        </form>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </section>
</main>

<%- include("partials/footer") %>
